{
  "description": "Frozen canonical name-normalization example table (migration step 1 of docs/normalization_migration_blocked.md). 'canonical' values are the proposed canonical_v2 policy; 'legacy' values are computed from the current code and pinned by tests/test_canonical_name_examples.py. Count keys use initial_char semantics; null count keys mean no lookup (missing), never sentinel counts.",
  "normalization_version": "canonical_v2",
  "decisions": {
    "D1": {
      "status": "open",
      "title": "No-spill multi-token given names",
      "description": "Canonical first keeps ALL tokens of the raw first field (space-separated), for spaced, dashed, and initialed forms alike; canonical middle comes from the raw middle field only. Legacy spills tokens 2..n of a non-dashed first into middle."
    },
    "D2": {
      "status": "decided",
      "title": "Apostrophes stripped globally",
      "description": "Apostrophes are removed (not turned into separators) in first, middle, AND last. Legacy strips them only in first; middle/last turn apostrophes into token breaks (O'Brien last -> 'o brien')."
    },
    "D3": {
      "status": "open",
      "title": "Uniform apostrophe-like marks",
      "description": "All apostrophe-like marks behave identically to ASCII apostrophe. Curly quotes already transliterate to ASCII ' via unidecode; backtick currently becomes a separator. Proposal: backtick (and similar) are apostrophes for name fields."
    },
    "D4": {
      "status": "decided",
      "title": "Dash-space equivalence",
      "description": "Every dash-like character is equivalent to a space at canonicalization; no ASCII/non-ASCII dash distinction anywhere (per migration doc Decided list)."
    },
    "D5": {
      "status": "decided",
      "title": "Spaced canonical surnames, spaced count keys",
      "description": "Canonical last names are stored as normalized space-separated tokens with particles preserved ('ou yang', 'van der berg'). Canonical count keys use the spaced forms; the compact-join shims (ouyang/vanderberg) are retired."
    },
    "D6": {
      "status": "open",
      "title": "Count-key informativeness and null semantics",
      "description": "first/first_last count keys exist only when the canonical first has at least one token longer than one character (so 'y z' is uninformative, 'jo ann' counts). Keys with a missing component are null (no lookups, NaN feature) instead of colliding with sentinel count 1."
    },
    "D7": {
      "status": "decided",
      "title": "Leading title prefixes dropped",
      "description": "A single leading NAME_PREFIXES token (dr, prof, ...) is dropped from first, as today. Edge to confirm: a prefix-only first canonicalizes to empty."
    },
    "D8": {
      "status": "decided",
      "title": "last_first_initial stays initial-char",
      "description": "The last_first_initial count key remains '<canonical last> <first initial char>' (initial_char semantics, matching the current default and Arrow contract)."
    }
  },
