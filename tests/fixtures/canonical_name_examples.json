{
  "description": "Frozen canonical name-normalization example table (migration step 1 of docs/normalization_migration_blocked.md). 'canonical' values are the ruled canonical_v2 policy; 'legacy' values are computed from the current code and pinned by tests/test_canonical_name_examples.py. Count keys use initial_char semantics; null count keys mean no lookup (missing), never sentinel counts. compare_compatibility encodes the compare-time equivalence contract (same_prefix_tokens) across variant groups that are deliberately not canonicalization-identical.",
  "normalization_version": "canonical_v2",
  "decisions": {
    "D1": {
      "status": "decided",
      "title": "Spill on space, keep together on dash",
      "description": "Canonical first keeps all tokens of the raw first field ONLY when the raw first contains a dash-like character; otherwise the first token stays and tokens 2..n spill into middle. Confirms the current dash-aware rule as canonical policy (ruled 2026-07-04, per the issue #39 findings: spaced Western firsts are usually first+middle, spaced Chinese compounds are handled upstream, and cross-variant compatibility of Jo / Jo Ann / JoAnn is compare-time via same_prefix_tokens, not canonicalization-identity)."
    },
    "D2": {
      "status": "decided",
      "title": "Apostrophes stripped globally",
      "description": "Apostrophes are removed (not turned into separators) in first, middle, AND last. Legacy strips them only in first; middle/last turn apostrophes into token breaks (O'Brien last -> 'o brien')."
    },
    "D3": {
      "status": "decided",
      "title": "Uniform apostrophe-like marks",
      "description": "All apostrophe-like marks (ASCII ', backtick `, acute, curly quotes, modifier letters, primes, saltillo, fullwidth) normalize to nothing in name fields (ruled 2026-07-04). Implementation: unify apostrophe-like code points to ASCII ' before unidecode, then delete ' and ` after unidecode."
    },
    "D4": {
      "status": "decided",
      "title": "Dash uniformity",
      "description": "All dash-like characters behave identically to one another; no ASCII vs Unicode dash distinction anywhere. For given names any dash keeps the first-field tokens together (see D1); for surnames dash and space variants canonicalize to the same spaced form (see D5)."
    },
    "D5": {
      "status": "decided",
      "title": "Spaced canonical surnames, spaced count keys",
      "description": "Canonical last names are stored as normalized space-separated tokens with particles preserved ('ou yang', 'van der berg'). Canonical count keys use the spaced forms; the compact-join shims (ouyang/vanderberg) are retired."
    },
    "D6": {
      "status": "decided",
      "title": "Count keys are canonical fields; null for missing (feature-semantics change)",
      "description": "Count keys use the canonical fields verbatim (no compaction), and keys with a missing component are null (no lookup / NaN feature). This changes live feature values: legacy always looks up last and last_first_initial even when a component is empty (empty first yields lfi key 'smith'; empty last yields lfi key 'j' plus the sentinel last=1 bug tracked in work_plan section 2). The change lands inside the single re-baseline/retrain cycle and is gated by its end-metric non-regression eval. The single-character informative gate for first/first_last is unchanged from legacy."
    },
    "D7": {
      "status": "decided",
      "title": "Leading title prefixes dropped",
      "description": "A single leading NAME_PREFIXES token (dr, prof, ...) is dropped from first, as today. A prefix-only first therefore canonicalizes to empty, and its first-dependent count keys are null per D6 (matches current field behavior)."
    },
    "D8": {
      "status": "decided",
      "title": "last_first_initial stays initial-char",
      "description": "The last_first_initial count key remains '<canonical last> <first initial char>' (initial_char semantics, matching the current default and Arrow contract)."
    }
  },
  "compare_compatibility": {
    "compatible_groups": [
      [
        "joann-spaced",
        "joann-dashed",
        "joann-joined"
      ],
      [
        "yuzhong-spaced",
