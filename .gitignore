# Legacy top-level data root. Current downloads and local datasets live under s2and/data/.
/data/

# Release bundles download into s2and/data/, the default data folder.
# Ignore everything there except the small tracked files; add an exception for each new tracked file.
s2and/data/*
!s2and/data/path_config.json
!s2and/data/first_k_letter_counts_from_orcid.json
!s2and/data/first_k_letter_counts_from_orcid.manifest.json
!s2and/data/s2and_name_tuples_canonical.txt
!s2and/data/s2and_name_tuples_filtered.txt
!s2and/data/s2and_unnormalized_filtered_name_tuples.txt
s2and/data-backup/


